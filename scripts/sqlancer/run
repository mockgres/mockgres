#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: scripts/sqlancer/run

Builds a pinned SQLancer checkout with the Mockgres compatibility profile,
starts fresh Mockgres servers, and runs a deterministic oracle matrix.

Environment:
  MOCKGRES_BIN             Server binary (default: target/debug/mockgres)
  MOCKGRES_JAVA            Java executable (default: JAVA_HOME or Maven runtime)
  SQLANCER_QUERIES         Checks per oracle/seed case (default: 1000)
  SQLANCER_ORACLES         Oracles (default: WHERE,NOREC,PQS,HAVING)
  SQLANCER_SEEDS           Seeds (default: 1,17,42,73,101)
  SQLANCER_ORACLE          Single-oracle shorthand for SQLANCER_ORACLES
  SQLANCER_SEED            Single-seed shorthand for SQLANCER_SEEDS
  SQLANCER_TIMEOUT_SECONDS Safety timeout per case (default: 60)
  SQLANCER_MAX_INSERTS     Maximum setup inserts per table (default: 16)
  SQLANCER_MAX_DEPTH       Maximum expression depth (default: 4)
  SQLANCER_STRING_LENGTH   Maximum string constant length (default: 32)
  PGPORT                   Reused server port (default: ephemeral per case)
  OUTDIR                   Artifact directory (default: target/sqlancer/runs/...)
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "") ;;
  *)
    usage >&2
    exit 2
    ;;
esac

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "${script_dir}/../.." && pwd)"
sqlancer_revision="af6ae85d0679c5a153d8e1cbf22c4e89980c0f68"
patch_file="${script_dir}/sqlancer.patch"
cache_root="${repo_root}/target/sqlancer/cache/${sqlancer_revision}"
source_dir="${cache_root}/source"
patch_stamp="${cache_root}/patch.sha256"

for command in git mvn python3; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$command is required" >&2
    exit 2
  fi
done
if [ ! -f "$patch_file" ]; then
  echo "missing SQLancer compatibility patch: $patch_file" >&2
  exit 2
fi

if command -v sha256sum >/dev/null 2>&1; then
  patch_hash="$(sha256sum "$patch_file" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
  patch_hash="$(shasum -a 256 "$patch_file" | awk '{print $1}')"
else
  echo "sha256sum or shasum is required" >&2
  exit 2
fi

cached_hash=""
if [ -f "$patch_stamp" ]; then
  cached_hash="$(sed -n '1p' "$patch_stamp")"
fi
if [ ! -d "${source_dir}/.git" ] || [ "$cached_hash" != "$patch_hash" ]; then
  rm -rf "$cache_root"
  mkdir -p "$cache_root"
  git -C "$cache_root" init -q source
  git -C "$source_dir" remote add origin https://github.com/sqlancer/sqlancer.git
  git -C "$source_dir" fetch -q --depth 1 origin "$sqlancer_revision"
  git -C "$source_dir" checkout -q --detach FETCH_HEAD
  git -C "$source_dir" apply "$patch_file"
  printf '%s\n' "$patch_hash" >"$patch_stamp"
fi

(cd "$source_dir" && mvn -q package -DskipTests)
sqlancer_jar="$(find "${source_dir}/target" -maxdepth 1 -type f -name 'sqlancer-*.jar' -print -quit)"
if [ -z "$sqlancer_jar" ]; then
  echo "SQLancer build did not produce a runnable jar" >&2
  exit 2
fi

if [ -n "${MOCKGRES_JAVA:-}" ]; then
  java_bin="$MOCKGRES_JAVA"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
  java_bin="${JAVA_HOME}/bin/java"
elif java -version >/dev/null 2>&1; then
  java_bin="$(command -v java)"
else
  java_home="$(mvn -q -DforceStdout help:evaluate -Dexpression=java.home 2>/dev/null | tail -n 1)"
  java_bin="${java_home}/bin/java"
fi
if [ ! -x "$java_bin" ]; then
  echo "Java 11 or newer was not found; set MOCKGRES_JAVA" >&2
  exit 2
fi

if [ -n "${MOCKGRES_BIN:-}" ]; then
  mockgres_bin="$MOCKGRES_BIN"
  if [ ! -x "$mockgres_bin" ]; then
    echo "Mockgres binary is not executable: $mockgres_bin" >&2
    exit 2
  fi
else
  (cd "$repo_root" && cargo build -p mockgres --bin mockgres)
  mockgres_bin="${repo_root}/target/debug/mockgres"
fi

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
outdir="${OUTDIR:-${repo_root}/target/sqlancer/runs/${run_id}}"
mkdir -p "$outdir"

server_pid=""
stop_server() {
  if [ -n "$server_pid" ] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  server_pid=""
}
trap stop_server EXIT INT TERM

queries="${SQLANCER_QUERIES:-1000}"
oracle_spec="${SQLANCER_ORACLES:-${SQLANCER_ORACLE:-WHERE NOREC PQS HAVING}}"
seed_spec="${SQLANCER_SEEDS:-${SQLANCER_SEED:-1 17 42 73 101}}"
timeout_seconds="${SQLANCER_TIMEOUT_SECONDS:-60}"
max_inserts="${SQLANCER_MAX_INSERTS:-16}"
max_depth="${SQLANCER_MAX_DEPTH:-4}"
string_length="${SQLANCER_STRING_LENGTH:-32}"

case "$queries" in
  ''|*[!0-9]*)
    echo "SQLANCER_QUERIES must be a positive integer" >&2
    exit 2
    ;;
esac
if [ "$queries" -eq 0 ]; then
  echo "SQLANCER_QUERIES must be a positive integer" >&2
  exit 2
fi

read -r -a oracles <<<"${oracle_spec//,/ }"
read -r -a seeds <<<"${seed_spec//,/ }"
if [ "${#oracles[@]}" -eq 0 ] || [ "${#seeds[@]}" -eq 0 ]; then
  echo "SQLANCER_ORACLES and SQLANCER_SEEDS cannot be empty" >&2
  exit 2
fi
for index in "${!oracles[@]}"; do
  oracles[$index]="${oracles[$index]^^}"
  case "${oracles[$index]}" in
    WHERE|NOREC|PQS|HAVING) ;;
    *)
      echo "unsupported Mockgres SQLancer oracle: ${oracles[$index]}" >&2
      echo "supported oracles: WHERE, NOREC, PQS, HAVING" >&2
      exit 2
      ;;
  esac
done

if command -v timeout >/dev/null 2>&1; then
  java_command=("$(command -v timeout)" "$timeout_seconds" "$java_bin")
elif command -v gtimeout >/dev/null 2>&1; then
  java_command=("$(command -v gtimeout)" "$timeout_seconds" "$java_bin")
else
  java_command=("$java_bin")
  echo "warning: timeout utility not found; campaign timeout is disabled" >&2
fi

allocate_port() {
  if [ -n "${PGPORT:-}" ]; then
    printf '%s\n' "$PGPORT"
    return
  fi
  python3 - <<'PY'
import socket

sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
}

wait_for_server() {
  python3 - "$1" <<'PY'
import socket
import sys
import time

port = int(sys.argv[1])
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.2):
            break
    except OSError:
        time.sleep(0.05)
else:
    raise SystemExit("Mockgres did not start within 10 seconds")
PY
}

summary="${outdir}/summary.tsv"
printf 'oracle\tseed\tqueries\tstatus\n' >"$summary"

run_case() {
  local oracle="$1"
  local seed="$2"
  local case_name case_out port server_log sqlancer_log status

  case_name="${oracle,,}-seed-${seed}"
  case_out="${outdir}/${case_name}"
  port="$(allocate_port)"
  server_log="${case_out}/mockgres.log"
  sqlancer_log="${case_out}/sqlancer.log"
  mkdir -p "$case_out"

  "$mockgres_bin" --host 127.0.0.1 --port "$port" --database test >"$server_log" 2>&1 &
  server_pid=$!
  wait_for_server "$port"

  rm -rf "${source_dir}/logs/postgres"
  set +e
  (
    cd "$source_dir"
    "${java_command[@]}" -jar "$sqlancer_jar" \
      --num-threads 1 \
      --num-queries "$queries" \
      --num-tries 1 \
      --max-generated-databases 1 \
      --random-seed "$seed" \
      --max-num-inserts "$max_inserts" \
      --max-expression-depth "$max_depth" \
      --string-constant-max-length "$string_length" \
      --database-prefix mockgres_sqlancer \
      --username postgres \
      --password mockgres \
      --host 127.0.0.1 \
      --port "$port" \
      --print-progress-information=false \
      --print-progress-summary=true \
      --exit-code-error=1 \
      postgres \
      --connection-url="postgresql://127.0.0.1:${port}/test" \
      --oracle "$oracle" \
      --test-collations=false \
      --test-tablespaces=false \
      --mockgres=true
  ) >"$sqlancer_log" 2>&1
  status=$?
  set -e

  if [ -d "${source_dir}/logs/postgres" ]; then
    mkdir -p "${case_out}/reproducers"
    cp -R "${source_dir}/logs/postgres/." "${case_out}/reproducers/"
  fi
  stop_server

  if [ "$status" -ne 0 ]; then
    printf '%s\t%s\t%s\tfail\n' "$oracle" "$seed" "$queries" >>"$summary"
    echo "SQLancer $oracle failed (seed $seed); artifacts: $case_out" >&2
    tail -n 80 "$sqlancer_log" >&2
    exit "$status"
  fi

  printf '%s\t%s\t%s\tpass\n' "$oracle" "$seed" "$queries" >>"$summary"
  echo "SQLancer $oracle passed $queries checks (seed $seed)"
}

for oracle in "${oracles[@]}"; do
  for seed in "${seeds[@]}"; do
    run_case "$oracle" "$seed"
  done
done

campaign_count=$((${#oracles[@]} * ${#seeds[@]}))
total_checks=$((campaign_count * queries))
echo "SQLancer passed $total_checks checks across $campaign_count cases"
echo "artifacts: $outdir"
