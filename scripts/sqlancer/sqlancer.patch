+                ResultSet rs = s.executeQuery("SELECT * FROM " + tableName + " LIMIT 0")) {
+            ResultSetMetaData metadata = rs.getMetaData();
+            for (int i = 1; i <= metadata.getColumnCount(); i++) {
+                PostgresDataType type;
+                switch (metadata.getColumnType(i)) {
+                case Types.SMALLINT:
+                case Types.INTEGER:
+                case Types.BIGINT:
+                    type = PostgresDataType.INT;
+                    break;
+                case Types.BOOLEAN:
+                case Types.BIT:
+                    type = PostgresDataType.BOOLEAN;
+                    break;
+                case Types.CHAR:
+                case Types.VARCHAR:
+                case Types.LONGVARCHAR:
+                    type = PostgresDataType.TEXT;
+                    break;
+                default:
+                    throw new AssertionError("unsupported Mockgres JDBC type: " + metadata.getColumnTypeName(i));
+                }
+                columns.add(new PostgresColumn(metadata.getColumnName(i), type));
+            }
+        }
+        return columns;
+    }
