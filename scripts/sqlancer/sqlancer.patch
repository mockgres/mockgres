+++ b/src/sqlancer/postgres/gen/MockgresTableGenerator.java
@@ -0,0 +1,41 @@
+package sqlancer.postgres.gen;
+
+import sqlancer.Randomly;
+import sqlancer.common.DBMSCommon;
+import sqlancer.common.query.SQLQueryAdapter;
+import sqlancer.postgres.PostgresSchema.PostgresDataType;
+
+public final class MockgresTableGenerator {
+    private MockgresTableGenerator() {
+    }
+
+    public static SQLQueryAdapter generate(String tableName) {
+        StringBuilder sql = new StringBuilder("CREATE TABLE ").append(tableName).append(" (");
+        int columnCount = Randomly.fromOptions(2, 3, 4, 5);
+        for (int i = 0; i < columnCount; i++) {
+            if (i != 0) {
+                sql.append(", ");
+            }
+            sql.append(DBMSCommon.createColumnName(i)).append(" ");
+            PostgresDataType type = PostgresDataType.getRandomType();
+            switch (type) {
+            case INT:
+                sql.append("BIGINT");
+                break;
+            case BOOLEAN:
+                sql.append("BOOLEAN");
+                break;
+            case TEXT:
+                sql.append("TEXT");
+                break;
+            case FLOAT:
+                sql.append("DOUBLE PRECISION");
+                break;
+            default:
+                throw new AssertionError(type);
+            }
+        }
+        sql.append(")");
+        return new SQLQueryAdapter(sql.toString(), true);
+    }
+}
